<Window x:Class="RingControl.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Iniciar sesión · Ring Control"
        Width="1016" Height="656"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        KeyDown="OnKeyDown">

    <Border Margin="18" CornerRadius="18" Background="{StaticResource AppBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.55" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ======================= Brand panel ======================= -->
            <Border Grid.Column="0" CornerRadius="17,0,0,17" MouseLeftButtonDown="OnDrag">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF15355A" Offset="0" />
                        <GradientStop Color="#FF0E1B2C" Offset="0.6" />
                        <GradientStop Color="#FF0C1118" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>

                <Grid ClipToBounds="True">
                    <Ellipse Width="380" Height="380" Stroke="#1FFFFFFF" StrokeThickness="1"
                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-140,-150,0" />
                    <Ellipse Width="260" Height="260" Stroke="#14FFFFFF" StrokeThickness="1"
                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-60,-80,0" />
                    <Ellipse Width="300" Height="300" Stroke="#0CFFFFFF" StrokeThickness="1"
                             HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-170,0,0,-170" />

                    <StackPanel Margin="40,42,40,34">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="42" Height="42" CornerRadius="13" Background="{StaticResource AccentBrush}">
                                <TextBlock Text="&#xE7ED;" Style="{StaticResource Glyph}" FontSize="19" Foreground="White" />
                            </Border>
                            <TextBlock Text="Ring Control" FontSize="17" FontWeight="SemiBold"
                                       Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="Tu timbre,&#x0a;en tu escritorio."
                                   FontFamily="{StaticResource DisplayFont}" FontSize="34" FontWeight="SemiBold"
                                   LineHeight="43" Margin="0,52,0,0" />
                        <TextBlock Text="Vídeo en directo, eventos y control de tus cámaras Ring desde un único lugar."
                                   Style="{StaticResource Caption}" FontSize="13.5" TextWrapping="Wrap"
                                   LineHeight="21" Margin="0,16,20,0" />

                        <StackPanel Margin="0,40,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Width="30" Height="30" CornerRadius="9" Background="#26FFFFFF">
                                    <TextBlock Text="&#xE714;" Style="{StaticResource Glyph}" FontSize="14" Foreground="#FFBBD4F5" />
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Vídeo en directo" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="Baja latencia con WebRTC" Style="{StaticResource MutedCaption}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Width="30" Height="30" CornerRadius="9" Background="#26FFFFFF">
                                    <TextBlock Text="&#xE81C;" Style="{StaticResource Glyph}" FontSize="14" Foreground="#FFBBD4F5" />
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Eventos y grabaciones" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="Revive cada movimiento y aviso" Style="{StaticResource MutedCaption}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <Border Width="30" Height="30" CornerRadius="9" Background="#26FFFFFF">
                                    <TextBlock Text="&#xE706;" Style="{StaticResource Glyph}" FontSize="14" Foreground="#FFBBD4F5" />
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Control rápido" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="Luz, sirena y detección" Style="{StaticResource MutedCaption}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="Proyecto no oficial. No afiliado a Ring LLC."
                                   Style="{StaticResource MutedCaption}" Margin="0,38,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ======================= Form panel ======================= -->
            <Grid Grid.Column="1" Margin="46,22,46,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnDrag">
                    <Button HorizontalAlignment="Right" Style="{StaticResource IconButton}"
                            Click="OnClose" ToolTip="Cerrar">
                        <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                    </Button>
                </Grid>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" MaxWidth="390" HorizontalAlignment="Left">
                    <TextBlock Text="Iniciar sesión" Style="{StaticResource PageTitle}" FontSize="28" />
                    <TextBlock Text="Usa tu cuenta de Ring. Ring no ofrece una API pública: esta aplicación usa la misma sesión que la app móvil."
                               Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="20" Margin="0,10,0,22" />

                    <Border Background="{StaticResource AccentSoftBrush}" BorderBrush="#FF2A4C7A" BorderThickness="1"
                            CornerRadius="9" Padding="12,9" Margin="0,0,0,14"
                            Visibility="{Binding InfoMessage, Converter={StaticResource StringToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" Style="{StaticResource Glyph}" FontSize="14"
                                       Foreground="{StaticResource AccentHoverBrush}" Margin="0,0,9,0" />
                            <TextBlock Text="{Binding InfoMessage}" Foreground="#FFBFD8FF" FontSize="12.5"
                                       TextWrapping="Wrap" MaxWidth="320" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource DangerSoftBrush}" BorderBrush="#FF5A2A31" BorderThickness="1"
                            CornerRadius="9" Padding="12,9" Margin="0,0,0,14"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" Style="{StaticResource Glyph}" FontSize="14"
                                       Foreground="#FFFCA5A5" Margin="0,0,9,0" />
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFFCA5A5" FontSize="12.5"
                                       TextWrapping="Wrap" MaxWidth="320" />
                        </StackPanel>
                    </Border>

                    <StackPanel Visibility="{Binding ShowCredentials, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Correo electrónico" Style="{StaticResource Caption}" Margin="2,0,0,6" />
                        <TextBox x:Name="EmailInput" Style="{StaticResource ModernTextBox}"
                                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Contraseña" Style="{StaticResource Caption}" Margin="2,16,0,6" />
                        <PasswordBox x:Name="PasswordInput" Style="{StaticResource ModernPasswordBox}" />

                        <Grid Margin="2,14,0,0">
                            <CheckBox Style="{StaticResource ModernCheckBox}" Content="Recordar correo"
                                      IsChecked="{Binding RememberEmail}" VerticalAlignment="Center" />
                            <TextBlock Text="Gestionar cuenta" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                       Cursor="Hand" MouseLeftButtonUp="OnManageAccount" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsTwoFactor, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Código de verificación" Style="{StaticResource Caption}" Margin="2,0,0,6" />
                        <TextBox x:Name="CodeInput" Style="{StaticResource ModernTextBox}" FontSize="18"
                                 MaxLength="10" Text="{Binding TwoFactorCode, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Volver" Style="{StaticResource GhostButton}" Padding="12,7"
                                HorizontalAlignment="Left" Margin="0,12,0,0"
                                Command="{Binding BackToCredentialsCommand}" />
                    </StackPanel>

                    <Button Content="{Binding SubmitText}" Style="{StaticResource PrimaryButton}" Height="46"
                            Margin="0,24,0,0" Command="{Binding SubmitCommand}" IsDefault="True" />

                    <TextBlock Text="La sesión se guarda cifrada con tu usuario de Windows. Puedes cerrarla en cualquier momento."
                               Style="{StaticResource MutedCaption}" TextWrapping="Wrap" LineHeight="18" Margin="2,18,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Ring Control · Cliente de escritorio no oficial" Style="{StaticResource MutedCaption}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
