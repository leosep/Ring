[Unit]
Description=RingControl NVR (grabación de cámaras y timbres Ring)
Documentation=https://github.com/leosep/Ring
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@GROUP@
WorkingDirectory=@PREFIX@
Environment=HOME=@HOME@
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=DOTNET_NOLOGO=1
ExecStart=@PREFIX@/ringcontrol nvr run@ROOT_ARG@
Restart=always
RestartSec=20
TimeoutStopSec=45
KillSignal=SIGTERM
SyslogIdentifier=ringcontrol-nvr
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@CONFIG_DIR@ @RECORDINGS@
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
